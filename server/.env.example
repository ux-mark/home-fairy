# Integration credentials and location now live in the Settings UI, persisted to
# the SQLite app_settings table. On first boot, if a setting is missing from the
# DB and present in this file, it will be seeded from here.
# After that, edit them at /settings in the running app.

PORT=3001
FAIRY_DB_PATH=./data/thefairies.sqlite
CORS_ORIGIN=http://localhost:8000
API_TIMEOUT=10000
KASA_SIDECAR_URL=http://127.0.0.1:3002
SONOS_API_URL=http://localhost:3003
# Better Auth — generate secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=your_auth_secret_here
BETTER_AUTH_URL=http://localhost:3001
